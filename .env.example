FLASK_SECRET_KEY=replace-with-a-local-secret
FLASK_DEBUG=false
STRIPE_PUBLIC_KEY=replace-with-a-test-publishable-key
STRIPE_SECRET_KEY=replace-with-a-test-secret-key
SENDGRID_API_KEY=replace-with-a-sendgrid-key

# Browser-facing application service locations.
CATALOGUE_SERVICE_URL=http://localhost:5004
VENUE_SERVICE_URL=http://localhost:5003
CART_SERVICE_URL=http://localhost:5005
REVIEW_SERVICE_URL=http://localhost:5007
PROCESS_REVIEW_SERVICE_URL=http://localhost:5400
VIEW_ORDER_SERVICE_URL=http://localhost:5300
PROCESS_ORDER_SERVICE_URL=http://localhost:5200
REFUND_SERVICE_URL=http://localhost:5700

# Local MySQL used by the six service schemas.
MYSQL_ROOT_PASSWORD=replace-with-a-local-database-password
CATALOGUE_DATABASE_URL=mysql+mysqlconnector://root:replace-with-a-local-database-password@localhost:3306/catalogue
CART_DATABASE_URL=mysql+mysqlconnector://root:replace-with-a-local-database-password@localhost:3306/cart
ORDER_DATABASE_URL=mysql+mysqlconnector://root:replace-with-a-local-database-password@localhost:3306/orders
REVIEW_DATABASE_URL=mysql+mysqlconnector://root:replace-with-a-local-database-password@localhost:3306/reviews
VENUE_DATABASE_URL=mysql+mysqlconnector://root:replace-with-a-local-database-password@localhost:3306/venue
USER_DATABASE_URL=mysql+mysqlconnector://root:replace-with-a-local-database-password@localhost:3306/users
